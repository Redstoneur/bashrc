# @function
# @name: hfm
# @description: Search the history for a command
# @usage: hfm command
# @param: $*: [same as grep]
function hfm() {
    hf "$*" | more
}

# @function
# @name: compress
# @description: Compresses a specified directory into a tar.gz archive, optionally with a custom version label.
# @usage: compress [directory] [version (format: v*-*-*)]
# @param: directory - Optional. The directory to compress. Defaults to the current working directory.
# @param: version - Optional. A custom version label for the archive, in the format v*-*-*.
function compress() {
  local usage="Usage: compress [directory] [version (format: v*-*-*)]"
  local version=$(date +"%Y-%m-%d_%H-%M-%S")
  local directory="$(pwd)"

  if [ $# -eq 1 ]; then
    if [ -d "$1" ]; then directory=$1; elif [[ "$1" == v*-*-* ]]; then version=$1; else echo "$usage"; return 1; fi
  elif [ $# -eq 2 ]; then
    if [ -d "$1" ]; then directory=$1; version=$2; else directory=$2; version=$1; fi
  elif [ $# -gt 2 ]; then
    echo "$usage"
    return 1
  fi

  local directory_name=$(basename "$directory")
  local archive_name="${directory}/${directory_name}_${version}.tar.gz"

  tar --exclude="./${archive_name}" -czf "$archive_name" "$directory"
  echo "Directory compressed successfully into $archive_name."
}

# @function
# @name: decompress
# @description: Decompresses a tar.gz archive into a specified directory.
# @usage: decompress <archive.tar.gz> [destination directory]
# @param: <archive.tar.gz> - Mandatory. The path to the tar.gz archive to decompress.
# @param: [destination directory] - Optional. The directory where the archive will be decompressed.
function decompress() {
  if [ $# -lt 1 ] || [ $# -gt 2 ] || [ ! -f "$1" ] || [[ "$1" != *.tar.gz ]]; then
    if [ $# -lt 1 ]; then
      echo "No argument provided."
    elif [ $# -gt 2 ]; then
      echo "Too many arguments provided."
    elif [ ! -f "$1" ]; then
      echo "The first argument is not a file."
    elif [[ "$1" != *.tar.gz ]]; then
      echo "The first argument is not a tar.gz archive."
    fi
    echo "Usage: decompress <archive.tar.gz> [destination directory]"
    return 1
  fi

  local archive_name=$1
  local destination_dir=${2:-$(pwd)/$(basename "$archive_name" .tar.gz)}

  if [ -d "$destination_dir" ]; then
    echo "Destination directory exists."
    return 1
  fi

  mkdir -p "$destination_dir" && tar -xzf "$archive_name" -C "$destination_dir"
  echo "Archive successfully decompressed to $destination_dir."
}

# @function
# @name: my_export
# @description: Display the exports
# @usage: my_export
# @param:
function my_export() {
  echo "Export :" # Display the title

  # Read the file line by line and display the exports
  while IFS= read -r line; do
    # Check if the line starts with "export"
    if [[ $line == "export"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the export
    fi
  done < $EXPORTS_FILE


}

# @function
# @name: my_alias
# @description: Display the aliases
# @usage: my_alias
# @param:
function my_alias() {
  echo "Alias :" # Display the title

  # Read the file line by line and display the aliases
  while IFS= read -r line; do
    # Check if the line starts with "alias"
    if [[ $line == "alias"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the alias
    fi
  done < $ALIAS_FILE
}

# @function
# @name: my_function
# @description: Display the functions
# @usage: my_function
# @param:
function my_function() {
  echo "Function :" # Display the title

  local test_function=0 # Test if the line is a function
  local function_name="" # The name of the function
  local function_desc="" # The description of the function

  # Read the file line by line and display the functions
  while IFS= read -r line; do
    # Check if the line starts with "# @function"
    if [[ $line == "# @function"* ]]; then
      test_function=1
    # Check if the line starts with "# @name" and the test_function is 1
    elif [[ $line == "# @name"* && $test_function -eq 1 ]]; then
      function_name=$(echo $line | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2- | sed 's/=/ --> /')

      test_function=2
    # Check if the line starts with "# @description" and the test_function is 2
    elif [[ $line == "# @description"* && $test_function -eq 2 ]]; then
      function_desc=$(echo $line | grep -oE "@description: [^\"]+" | cut -d ' ' -f 2- | sed 's/=/ --> /')

      echo "$function_name --> $function_desc"

      function_name=""
      function_desc=""
      test_function=0
    else # If the line is not a function
      test_function=0
    fi
  done < $FUNCTIONS_FILE
}

# @function
# @name: my_source
# @description: Source the files
# @usage: my_source
# @param:
function my_source() {
  echo "Source :" # Display the title

  echo ".bashrc" # Display the file

  # Read the file line by line and display the sources
  while IFS= read -r line; do
    # Check if the line starts with "source"
    if [[ $line == "source"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the source
    fi
  done < $BASHRC_FILE
}

# @function
# @name: my
# @description: Display the exports, aliases, functions, and source the files
# @usage: my
# @param:
function my() {
  # Display the exports, aliases, functions, and source the files
  my_export
  echo ""
  my_alias
  echo ""
  my_function
  echo ""
  my_source
}

# @function
# @name: my_man
# @description: Display the information about un alias, function, export, or source custom command
# @usage: my_man command
# @param: $1: The command to display the information about
function my_man() {
  if [ $# -ne 1 ]; then
    if [ $# -lt 1 ]; then
      echo "Too few parameters : 1 parameter expected"
    else
      echo "Too many parameters : 1 parameter expected"
    fi
    return 1
  fi

  local name_of_command=$1

  if [ -z "$name_of_command" ]; then
    echo "Empty command name"
    return 1
  fi

  extract_custom_commands_info() {
    local type=$1
    local name=$(echo "$2" | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-)
    local desc=$(echo "$3" | grep -oE "@description: [^\"]+" | cut -d ' ' -f 2-)
    echo "Commande $name :"
    echo "- Name : $name"
    echo "- Type : $type"
    echo "- description : $desc"

    if [[ $4 != "" ]]; then
      local usage=$(echo "$4" | grep -oE "@usage: [^\"]+" | cut -d ' ' -f 2-)
      echo "- Usage : $usage"
    fi

    # Nouvelle boucle pour gérer plusieurs paramètres
    shift 4 # Ignorer les 4 premiers arguments déjà utilisés
    for param in "$@"; do
      if [[ $param != "" ]]; then
        local param_info=$(echo "$param" | grep -oE "@param: [^\"]+" | cut -d ' ' -f 2-)
        echo "- Param : $param_info"
      fi
    done
  }

  local all_data=$(cat $BASHRC_FILE $ALIAS_FILE $FUNCTIONS_FILE $EXPORTS_FILE)
  local type="NONE"
  local params=() # Tableau pour stocker les lignes de paramètres

  while IFS= read -r line; do
    if [[ $line == "# @alias"* ]]; then
      type="ALIAS"
    elif [[ $line == "# @export"* ]]; then
      type="EXPORT"
    elif [[ $line == "# @function"* ]]; then
      type="FUNCTION"
    elif [[ $line == "# @source"* ]]; then
      type="SOURCE"
    elif [[ $line == "# @name"* && "$type" != "NONE" ]]; then
      nameLine=$line
      name=$(echo $line | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-)
    elif [ "$name" == "$name_of_command" ]; then
      if [[ $line == "# @description"* ]]; then
        descLine=$line
      elif [[ $line == "# @usage"* ]]; then
        usageLine=$line
      elif [[ $line == "# @param"* ]]; then
        params+=("$line") # Ajouter la ligne de paramètre au tableau
      else
        if [[ ${#params[@]} -gt 0 ]]; then
          extract_custom_commands_info "$type" "$nameLine" "$descLine" "$usageLine" "${params[@]}"
          return 0
        fi
      fi
    else
      type="NONE"
      name=""
      nameLine=""
      descLine=""
      usageLine=""
      params=() # Réinitialiser le tableau de paramètres
    fi
  done <<< "$all_data"

  echo "Commande non trouvée"
}
