# Function to search the history for a command
# @function
# @name: hfm
# @description: Search the history for a command
# @usage: hfm command
# @param: $*: [same as grep]
function hfm() {
    hf "$*" | more
}

# Function to compress a specified directory into a tar.gz archive
# @function
# @name: compress
# @description: Compresses a specified directory into a tar.gz archive, optionally with a custom version label.
# @usage: compress [directory] [version (format: v*-*-*)]
# @param: directory - Optional. The directory to compress. Defaults to the current working directory.
# @param: version - Optional. A custom version label for the archive, in the format v*-*-*.
function compress() {
  local usage="Usage: compress [directory] [version (format: v*-*-*)]"
  local version=$(date +"%Y-%m-%d_%H-%M-%S") # Default version label based on current date and time
  local directory="$(pwd)" # Default directory is the current working directory

  # Handle command line arguments
  if [ $# -eq 1 ]; then
    if [ -d "$1" ]; then directory=$1; elif [[ "$1" == v*-*-* ]]; then version=$1; else echo "$usage"; return 1; fi
  elif [ $# -eq 2 ]; then
    if [ -d "$1" ]; then directory=$1; version=$2; else directory=$2; version=$1; fi
  elif [ $# -gt 2 ]; then
    echo "$usage"
    return 1
  fi

  local directory_name=$(basename "$directory") # Extract the name of the directory
  local archive_name="${directory}/${directory_name}_${version}.tar.gz" # Construct the archive name

  tar --exclude="./${archive_name}" -czf "$archive_name" "$directory" # Create the tar.gz archive
  echo "Directory compressed successfully into $archive_name."
}

# Function to decompress a tar.gz archive into a specified directory
# @function
# @name: decompress
# @description: Decompresses a tar.gz archive into a specified directory.
# @usage: decompress <archive.tar.gz> [destination directory]
# @param: <archive.tar.gz> - Mandatory. The path to the tar.gz archive to decompress.
# @param: [destination directory] - Optional. The directory where the archive will be decompressed.
function decompress() {
  # Validate input arguments
  if [ $# -lt 1 ] || [ $# -gt 2 ] || [ ! -f "$1" ] || [[ "$1" != *.tar.gz ]]; then
    if [ $# -lt 1 ]; then
      echo "No argument provided."
    elif [ $# -gt 2 ]; then
      echo "Too many arguments provided."
    elif [ ! -f "$1" ]; then
      echo "The first argument is not a file."
    elif [[ "$1" != *.tar.gz ]]; then
      echo "The first argument is not a tar.gz archive."
    fi
    echo "Usage: decompress <archive.tar.gz> [destination directory]"
    return 1
  fi

  local archive_name=$1 # The tar.gz archive to decompress
  local destination_dir=${2:-$(pwd)/$(basename "$archive_name" .tar.gz)} # Default destination directory

  # Check if destination directory exists
  if [ -d "$destination_dir" ]; then
    echo "Destination directory exists."
    return 1
  fi

  mkdir -p "$destination_dir" && tar -xzf "$archive_name" -C "$destination_dir" # Decompress the archive
  echo "Archive successfully decompressed to $destination_dir."
}

# Function to display information about a custom command (alias, function, export, or source)
# @function
# @name: my_man
# @description: Display the information about un alias, function, export, or source custom command
# @usage: my_man command
# @param: $1: The command to display the information about
function my_man() {
  if [ $# -ne 1 ]; then
    if [ $# -lt 1 ]; then
      echo "Too few parameters : 1 parameter expected"
    else
      echo "Too many parameters : 1 parameter expected"
    fi
    return 1
  fi

  local name_of_command=$1 # The name of the command to display information about

  if [ -z "$name_of_command" ]; then
    echo "Empty command name"
    return 1
  fi

  # Function to extract and display information about custom commands
  extract_custom_commands_info() {
    local type=$1 # The type of the custom command (alias, function, export, or source)
    local name=$(echo "$2" | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-) # The name of the custom command
    local desc=$(echo "$3" | grep -oE "@description: [^\"]+" | cut -d ' ' -f 2-) # The description of the custom command
    echo "Commande $name :"
    echo "- Name : $name"
    echo "- Type : $type"
    echo "- description : $desc"

    if [[ $4 != "" ]]; then
      local usage=$(echo "$4" | grep -oE "@usage: [^\"]+" | cut -d ' ' -f 2-) # The usage of the custom command
      echo "- Usage : $usage"
    fi

    # Loop to handle multiple parameters
    shift 4 # Ignore the first four arguments already used
    for param in "$@"; do
      if [[ $param != "" ]]; then
        local param_info=$(echo "$param" | grep -oE "@param: [^\"]+" | cut -d ' ' -f 2-) # Information about each parameter
        echo "- Param : $param_info"
      fi
    done
  }

  local all_data=$(cat $BASHRC_FILE $ALIAS_FILE $FUNCTIONS_FILE $EXPORTS_FILE) # Concatenate all custom command files
  local type="NONE" # Initialize the type of custom command
  local params=() # Array to store parameter lines

  # Loop through all lines in the concatenated custom command files
  while IFS= read -r line; do
    # Determine the type of custom command based on the line prefix
    if [[ $line == "# @alias"* ]]; then
      type="ALIAS"
    elif [[ $line == "# @export"* ]]; then
      type="EXPORT"
    elif [[ $line == "# @function"* ]]; then
      type="FUNCTION"
    elif [[ $line == "# @source"* ]]; then
      type="SOURCE"
    elif [[ $line == "# @name"* && "$type" != "NONE" ]]; then
      nameLine=$line
      name=$(echo $line | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-)
    elif [ "$name" == "$name_of_command" ]; then
      # Extract and display information about the custom command
      if [[ $line == "# @description"* ]]; then
        descLine=$line
      elif [[ $line == "# @usage"* ]]; then
        usageLine=$line
      elif [[ $line == "# @param"* ]]; then
        params+=("$line") # Add parameter line to the array
      else
        if [[ ${#params[@]} -gt 0 ]]; then
          extract_custom_commands_info "$type" "$nameLine" "$descLine" "$usageLine" "${params[@]}"
          return 0
        fi
      fi
    else
      # Reset variables for the next custom command
      type="NONE"
      name=""
      nameLine=""
      descLine=""
      usageLine=""
      params=() # Reset the parameter array
    fi
  done <<< "$all_data"

  echo "Commande non trouvée"
}