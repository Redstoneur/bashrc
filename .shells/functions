# @function
# @name: hfm
# @description: Search the history for a command
# @usage: hfm command
# @param: $*: [same as grep]
function hfm() {
    hf "$*" | more
}

# @function
# @name: compress
# @description: Compresses a specified directory into a tar.gz archive, optionally with a custom version label.
# @usage: compress [directory] [version (format: v*-*-*)]
# @param: directory - Optional. The directory to compress. Defaults to the current working directory.
# @param: version - Optional. A custom version label for the archive, in the format v*-*-*.
function compress() {
  local current_directory
  local directory
  local version
  local directory_name
  local archive_name

  usage() {
    # Displays usage information and exits.
    echo "Usage: $0 [directory] [version (format: v*-*-*)]"
    return 1
  }

  # Get current working directory
  current_directory=$(pwd)
  # Default directory to compress, set to the current working directory.
  directory="$(pwd)"
  # Default version label, formatted as vYYYY-MM-DD_HH-MM-SS.
  version=$(date +"%Y-%m-%d_%H-%M-%S")

  # Process command-line arguments.
  if [ $# -eq 1 ]; then
    # If there is exactly one argument, determine if it's a directory or version label.
    if [ -d "$1" ]; then directory=$1; elif [[ "$1" == v*-*-* ]]; then version=$1; else usage; return 1; fi
  elif [ $# -eq 2 ]; then
    # If there are two arguments, assign them to directory and version based on their type.
    if [[ -d "$1" || "$2" =~ ^v.*-.*-.*$ ]]; then
        directory=$1
        version=$2
    elif [[ -d "$2" || "$1" =~ ^v.*-.*-.*$ ]]; then
        directory=$2
        version=$1
    else
        usage
        return 1
    fi
  elif [ $# -gt 2 ]; then
    # If more than two arguments are provided, display usage information.
    usage
    return 1
  fi

  # Get the base name of the directory to use in the archive name.
  directory_name=$(basename "$directory")
  # Construct the archive name using the directory name and version label.
  archive_name="${current_directory}/${directory_name}_${version}.tar.gz"

  echo "Creating archive: $archive_name"

  # Aller dans le répertoire
  cd "$directory" || return 1

  # Create the tar.gz archive, excluding the archive file itself if it's in the same directory.
  tar --exclude="./${archive_name}" -czf "$archive_name" ./*

  cd "${current_directory}" || return 1

  # Confirm success to the user.
  echo "Directory compressed successfully into ${archive_name}."

  return 0
}

# @function
# @name: decompress
# @description: Decompresses a tar.gz archive into a specified directory.
# @usage: decompress <archive.tar.gz> [destination directory]
# @param: <archive.tar.gz> - Mandatory. The path to the tar.gz archive to decompress.
# @param: [destination directory] - Optional. The directory where the archive will be decompressed.
function decompress() {
  usage() {
    # Display usage information and exit.
    echo "Usage: $0 <archive.tar.gz> [destination directory]"
    return 1
  }

  # Validate input arguments
  if [ $# -lt 1 ] || [ $# -gt 2 ] || [ ! -f "$1" ] || [[ "$1" != *.tar.gz ]]; then
    if [ $# -lt 1 ]; then
      echo "No argument provided."
    elif [ $# -gt 2 ]; then
      echo "Too many arguments provided."
    elif [ ! -f "$1" ]; then
      echo "The first argument is not a file."
    elif [[ "$1" != *.tar.gz ]]; then
      echo "The first argument is not a tar.gz archive."
    fi
    usage
    return 1
  fi

  # Assign the first argument to archive_name.
  archive_name=$1
  # Determine the destination directory. Use the second argument if provided,
  # otherwise, default to a directory named after the archive within the current working directory.
  destination_dir=${2:-$(pwd)/$(basename "$archive_name" .tar.gz)}

  # Check if destination directory exists
  if [ -d "$destination_dir" ]; then
    echo "Destination directory exists."
    usage
    return 1
  fi

  # Create the destination directory and decompress the archive into it.
  mkdir -p "$destination_dir" && tar -xzf "$archive_name" -C "$destination_dir"
  # Confirm successful decompression.
  echo "Archive successfully decompressed to $destination_dir."

  return 0
}

# @function
# @name: my_export
# @description: Display the exports
# @usage: my_export
# @param:
function my_export() {
  echo "Export :" # Display the title

  # Read the file line by line and display the exports
  while IFS= read -r line; do
    # Check if the line starts with "export"
    if [[ $line == "export"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the export
    fi
  done < $EXPORTS_FILE
}

# @function
# @name: my_alias
# @description: Display the aliases
# @usage: my_alias
# @param:
function my_alias() {
  echo "Alias :" # Display the title

  # Read the file line by line and display the aliases
  while IFS= read -r line; do
    # Check if the line starts with "alias"
    if [[ $line == "alias"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the alias
    fi
  done < $ALIAS_FILE
}

# @function
# @name: my_function
# @description: Display the functions
# @usage: my_function
# @param:
function my_function() {
  echo "Function :" # Display the title

  local test_function=0 # Test if the line is a function
  local function_name="" # The name of the function
  local function_desc="" # The description of the function

  # Read the file line by line and display the functions
  while IFS= read -r line; do
    # Check if the line starts with "# @function"
    if [[ $line == "# @function"* ]]; then
      test_function=1
    # Check if the line starts with "# @name" and the test_function is 1
    elif [[ $line == "# @name"* && $test_function -eq 1 ]]; then
      function_name=$(echo $line | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2- | sed 's/=/ --> /')

      test_function=2
    # Check if the line starts with "# @description" and the test_function is 2
    elif [[ $line == "# @description"* && $test_function -eq 2 ]]; then
      function_desc=$(echo $line | grep -oE "@description: [^\"]+" | cut -d ' ' -f 2- | sed 's/=/ --> /')

      echo "$function_name --> $function_desc"

      function_name=""
      function_desc=""
      test_function=0
    else # If the line is not a function
      test_function=0
    fi
  done < $FUNCTIONS_FILE
}

# @function
# @name: my_source
# @description: Source the files
# @usage: my_source
# @param:
function my_source() {
  echo "Source :" # Display the title

  echo ".bashrc" # Display the file

  # Read the file line by line and display the sources
  while IFS= read -r line; do
    # Check if the line starts with "source"
    if [[ $line == "source"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the source
    fi
  done < $BASHRC_FILE
}

# @function
# @name: my
# @description: Display the exports, aliases, functions, and source the files
# @usage: my
# @param:
function my() {
  # Display the exports, aliases, functions, and source the files
  my_export
  echo ""
  my_alias
  echo ""
  my_function
  echo ""
  my_source
}

# @function
# @name: my_man
# @description: Display the information about un alias, function, export, or source custom command
# @usage: my_man command
# @param: $1: The command to display the information about
function my_man() {
  if [ $# -ne 1 ]; then
    if [ $# -lt 1 ]; then
      echo "Too few parameters : 1 parameter expected"
    else
      echo "Too many parameters : 1 parameter expected"
    fi
    return 1
  fi

  local name_of_command=$1 # The name of the command to display information about

  if [ -z "$name_of_command" ]; then
    echo "Empty command name"
    return 1
  fi

  # Function to extract and display information about custom commands
  extract_custom_commands_info() {
    local type=$1 # The type of the custom command (alias, function, export, or source)
    local name=$(echo "$2" | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-) # The name of the custom command
    local desc=$(echo "$3" | grep -oE "@description: [^\"]+" | cut -d ' ' -f 2-) # The description of the custom command
    echo "Commande $name :"
    echo "- Name : $name"
    echo "- Type : $type"
    echo "- description : $desc"

    if [[ $4 != "" ]]; then
      local usage=$(echo "$4" | grep -oE "@usage: [^\"]+" | cut -d ' ' -f 2-) # The usage of the custom command
      echo "- Usage : $usage"
    fi

    # if type is export, don't continue
    if [[ $type == "EXPORT" ]]; then
      return 0
    fi

    # Loop to handle multiple parameters
    shift 4 # Ignore the first four arguments already used
    for param in "$@"; do
      if [[ $param != "" ]]; then
        local param_info=$(echo "$param" | grep -oE "@param: [^\"]+" | cut -d ' ' -f 2-) # Information about each parameter
        echo "- Param : $param_info"
      fi
    done
  }

  local all_data=$(cat $BASHRC_FILE $ALIAS_FILE $FUNCTIONS_FILE $EXPORTS_FILE) # Concatenate all custom command files
  local type="NONE" # Initialize the type of custom command
  local params=() # Array to store parameter lines

  # Loop through all lines in the concatenated custom command files
  while IFS= read -r line; do
    # Determine the type of custom command based on the line prefix
    if [[ $line == "# @alias"* ]]; then
      type="ALIAS"
    elif [[ $line == "# @export"* ]]; then
      type="EXPORT"
    elif [[ $line == "# @function"* ]]; then
      type="FUNCTION"
    elif [[ $line == "# @source"* ]]; then
      type="SOURCE"
    elif [[ $line == "# @name"* && "$type" != "NONE" ]]; then
      nameLine=$line
      name=$(echo $line | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-)
    elif [ "$name" == "$name_of_command" ]; then
      # Extract and display information about the custom command
      if [[ $line == "# @description"* ]]; then
        descLine=$line
      elif [[ $line == "# @usage"* ]]; then
        usageLine=$line
      elif [[ $line == "# @param"* ]]; then
        params+=("$line") # Add parameter line to the array
      else
        if [[ ${#params[@]} -gt 0 ]]; then
          extract_custom_commands_info "$type" "$nameLine" "$descLine" "$usageLine" "${params[@]}"
          return 0
        fi
      fi
    else
      # Reset variables for the next custom command
      type="NONE"
      name=""
      nameLine=""
      descLine=""
      usageLine=""
      params=() # Reset the parameter array
    fi
  done <<< "$all_data"

  echo "Commande non trouvée"
}
