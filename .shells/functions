# @function
# @name: compress
# @description: Compresses a specified directory into a tar.gz archive, optionally with a custom version label.
# @usage: compress [directory] [version (format: v*-*-*)]
# @param: [directory] - Optional. The directory to compress. Defaults to the current working directory.
# @param: [version] - Optional. A custom version label for the archive, in the format v*-*-*.
function compress() {
  local current_directory
  local directory
  local version
  local directory_name
  local archive_name

  usage() {
    # Displays usage information and exits.
    echo "Usage: $0 [directory] [version (format: v*-*-*)]"
    return 1
  }

  # Get current working directory
  current_directory=$(pwd)
  # Default directory to compress, set to the current working directory.
  directory="$(pwd)"
  # Default version label, formatted as vYYYY-MM-DD_HH-MM-SS.
  version=$(date +"%Y-%m-%d_%H-%M-%S")

  # Process command-line arguments.
  if [ $# -eq 1 ]; then
    # If there is exactly one argument, determine if it's a directory or version label.
    if [ -d "$1" ]; then directory=$1; elif [[ "$1" == v*-*-* ]]; then version=$1; else usage; return 1; fi
  elif [ $# -eq 2 ]; then
    # If there are two arguments, assign them to directory and version based on their type.
    if [[ -d "$1" || "$2" =~ ^v.*-.*-.*$ ]]; then
        directory=$1
        version=$2
    elif [[ -d "$2" || "$1" =~ ^v.*-.*-.*$ ]]; then
        directory=$2
        version=$1
    else
        usage
        return 1
    fi
  elif [ $# -gt 2 ]; then
    # If more than two arguments are provided, display usage information.
    usage
    return 1
  fi

  # Get the base name of the directory to use in the archive name.
  directory_name=$(basename "$directory")
  # Construct the archive name using the directory name and version label.
  archive_name="${current_directory}/${directory_name}_${version}.tar.gz"

  echo "Creating archive: $archive_name"

  # Change to the target directory
  cd "$directory" || return 1

  # Create the tar.gz archive, excluding the archive file itself if it's in the same directory.
  tar --exclude="./${archive_name}" -czf "$archive_name" ./*

  cd "${current_directory}" || return 1

  # Confirm success to the user.
  echo "Directory compressed successfully into ${archive_name}."

  return 0
}

# @function
# @name: decompress
# @description: Decompresses a tar.gz archive into a specified directory.
# @usage: decompress <archive.tar.gz> [destination directory]
# @param: <archive.tar.gz> - Mandatory. The path to the tar.gz archive to decompress.
# @param: [destination directory] - Optional. The directory where the archive will be decompressed.
function decompress() {
  usage() {
    # Display usage information and exit.
    echo "Usage: $0 <archive.tar.gz> [destination directory]"
    return 1
  }

  # Validate input arguments
  if [ $# -lt 1 ] || [ $# -gt 2 ] || [ ! -f "$1" ] || [[ "$1" != *.tar.gz ]]; then
    if [ $# -lt 1 ]; then
      echo "No argument provided."
    elif [ $# -gt 2 ]; then
      echo "Too many arguments provided."
    elif [ ! -f "$1" ]; then
      echo "The first argument is not a file."
    elif [[ "$1" != *.tar.gz ]]; then
      echo "The first argument is not a tar.gz archive."
    fi
    usage
    return 1
  fi

  # Assign the first argument to archive_name.
  archive_name=$1
  # Determine the destination directory. Use the second argument if provided,
  # otherwise, default to a directory named after the archive within the current working directory.
  destination_dir=${2:-$(pwd)/$(basename "$archive_name" .tar.gz)}

  # Check if destination directory exists
  if [ -d "$destination_dir" ]; then
    echo "Destination directory exists."
    usage
    return 1
  fi

  # Create the destination directory and decompress the archive into it.
  mkdir -p "$destination_dir" && tar -xzf "$archive_name" -C "$destination_dir"
  # Confirm successful decompression.
  echo "Archive successfully decompressed to $destination_dir."

  return 0
}

# Function to copy a directory to another location with options to preserve attributes
# @function
# @name: copy_directory
# @description: Copies a source directory to a specified destination directory, preserving file attributes.
# @usage: copy_directory <source_directory> [destination_directory]
# @param: source_directory - Mandatory. The path to the source directory to copy.
# @param: destination_directory - Optional. The destination directory path. Defaults to the current working directory if not specified.
function copy_directory() {
  usage() {
    echo "Usage: $0 <source_directory> [destination_directory]"
    return 1
  }

  # Check the number of arguments
  if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    usage
  fi

  local SOURCE_DIR=$1

  # If the second argument is not provided, use the current directory
  local DEST_DIR=${2:-$(pwd)}

  # Check if source and destination directories are the same
  if [ "$SOURCE_DIR" -ef "$DEST_DIR" ]; then
    echo "The source and destination directories cannot be the same."
    return 1
  fi

  # Check if the source directory exists
  if [ ! -d "$SOURCE_DIR" ]; then
    echo "The source directory does not exist."
    return 1
  fi

  # Create the destination directory if it does not exist
  mkdir -p "$DEST_DIR"

  # Empty the destination directory to make it identical to the source
  rm -rf "$DEST_DIR"/*

  # Copy the source directory to the destination with identical rights and dates
  cp -a "$SOURCE_DIR"/. "$DEST_DIR"

  echo "Directory copy was successful."
}

# Function to verify the copy of a directory with an option to exclude .git directories
# @function
# @name: verify_copy
# @description: Verifies if the copy of a source directory to a destination directory is identical, with an option to exclude .git directories.
# @usage: verify_copy <exclude_git: 0|1> <source_directory> [destination_directory]
# @param: exclude_git - Mandatory. Indicates whether to exclude .git directories (1) or not (0).
# @param: source_directory - Mandatory. The path to the source directory to verify.
# @param: destination_directory - Optional. The destination directory path. Defaults to the current working directory if not specified.
function verify_copy() {
  usage() {
    echo "Usage: $0 <exclude_git: 0|1> <source_directory> [destination_directory]"
    return 1
  }

  # Check the number of arguments
  if [ $# -lt 2 ] || [ $# -gt 3 ]; then
    usage
  fi

  local EXCLUDE_GIT=$1
  local SOURCE_DIR=$2
  local DEST_DIR=${3:-$(pwd)}

  # Check if the EXCLUDE_GIT argument is valid
  if [ "$EXCLUDE_GIT" -ne 0 ] && [ "$EXCLUDE_GIT" -ne 1 ]; then
    usage
  fi

  # Check if the source and destination directories exist
  if [ ! -d "$SOURCE_DIR" ]; then
    echo "The source directory does not exist."
    return 1
  fi

  if [ ! -d "$DEST_DIR" ]; then
    echo "The destination directory does not exist."
    return 1
  fi

  # Check if source and destination directories are the same
  if [ "$SOURCE_DIR" -ef "$DEST_DIR" ]; then
    echo "The source and destination directories cannot be the same."
    return 1
  fi

  # Build the comparison command
  local diff_output
  if [ "$EXCLUDE_GIT" -eq 1 ]; then
    diff_output=$(diff -r --no-dereference --brief --exclude=".git" "$SOURCE_DIR" "$DEST_DIR")
  else
    diff_output=$(diff -r --no-dereference --brief "$SOURCE_DIR" "$DEST_DIR")
  fi

  # Display the comparison result
  if [ -z "$diff_output" ]; then
    echo "The directories are strictly identical."
    return 0
  else
    echo "The directories are not identical:"
    echo "$diff_output"
    return 1
  fi
}

# @function
# @name: update_system
# @description: Updates the system by detecting and using the appropriate package manager command for the current Linux distribution.
# @usage: update_system
# @param: None
function update_system() {
  local OS
  local VER

  # Detect the Linux distribution
  if [ -f /etc/os-release ]; then
      . /etc/os-release
      # shellcheck disable=SC2153
      OS=$NAME
      VER=$VERSION_ID
  elif type lsb_release >/dev/null 2>&1; then
      OS=$(lsb_release -si)
      VER=$(lsb_release -sr)
  elif [ -f /etc/lsb-release ]; then
      . /etc/lsb-release
      OS=$DISTRIB_ID
      VER=$DISTRIB_RELEASE
  elif [ -f /etc/debian_version ]; then
      OS="Debian"
      # shellcheck disable=SC2034
      VER=$(cat /etc/debian_version)
  else
      echo "Your distribution is not recognized. Update cancelled."
      return 1
  fi

  # Update according to the distribution
  case $OS in
      Ubuntu|Debian|Linux\ Mint)
          sudo apt-get update -y && sudo apt-get upgrade -y
          ;;
      Fedora)
          sudo dnf -y update && sudo dnf -y upgrade
          ;;
      CentOS)
          sudo yum update -y && sudo yum upgrade -y
          ;;
      Arch\ Linux)
          sudo pacman -Syu
          ;;
      *)
          echo "Distribution '$OS' is not supported for automatic update."
          return 1
          ;;
  esac

  echo "Update completed."
}

# @function
# @name: my_export
# @description: Display the exports
# @usage: my_export
# @param: None
function my_export() {
  echo "Exports:" # Display the title

  # Read the file line by line and display the exports
  while IFS= read -r line; do
    # Check if the line starts with "export"
    if [[ $line == "export"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the export
    fi
  done < $EXPORTS_FILE
}

# @function
# @name: my_alias
# @description: Display the aliases
# @usage: my_alias
# @param: None
function my_alias() {
  echo "Aliases:" # Display the title

  # Read the file line by line and display the aliases
  while IFS= read -r line; do
    # Check if the line starts with "alias"
    if [[ $line == "alias"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the alias
    fi
  done < $ALIAS_FILE
}

# @function
# @name: my_function
# @description: Display the functions
# @usage: my_function
# @param: None
function my_function() {
  echo "Functions:" # Display the title

  local test_function=0 # Test if the line is a function
  local function_name="" # The name of the function
  local function_desc="" # The description of the function

  # Read the file line by line and display the functions
  while IFS= read -r line; do
    # Check if the line starts with "# @function"
    if [[ $line == "# @function"* ]]; then
      test_function=1
    # Check if the line starts with "# @name" and the test_function is 1
    elif [[ $line == "# @name"* && $test_function -eq 1 ]]; then
      function_name=$(echo $line | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2- | sed 's/=/ --> /')

      test_function=2
    # Check if the line starts with "# @description" and the test_function is 2
    elif [[ $line == "# @description"* && $test_function -eq 2 ]]; then
      function_desc=$(echo $line | grep -oE "@description: [^\"]+" | cut -d ' ' -f 2- | sed 's/=/ --> /')

      echo "$function_name --> $function_desc"

      function_name=""
      function_desc=""
      test_function=0
    else # If the line is not a function
      test_function=0
    fi
  done < $FUNCTIONS_FILE
}

# @function
# @name: my_source
# @description: Source the files
# @usage: my_source
# @param: None
function my_source() {
  echo "Source:" # Display the title

  echo ".bashrc" # Display the file

  # Read the file line by line and display the sources
  while IFS= read -r line; do
    # Check if the line starts with "source"
    if [[ $line == "source"* ]]; then
      echo $line | cut -d ' ' -f 2- | sed 's/=/ --> /' # Display the source
    fi
  done < $BASHRC_FILE
}

# @function
# @name: my
# @description: Display the exports, aliases, functions, and source the files
# @usage: my
# @param: None
function my() {
  # Display the exports, aliases, functions, and source the files
  my_export
  echo ""
  my_alias
  echo ""
  my_function
  echo ""
  my_source
}

# @function
# @name: my_man
# @description: Display the information about an alias, function, export, or source custom command
# @usage: my_man command
# @param: [command] - The name of the command to display information about
function my_man() {
  local name_of_command
  local all_data
  local type
  local params

  if [ $# -ne 1 ]; then
    if [ $# -lt 1 ]; then
      echo "Too few parameters: 1 parameter expected"
      echo
      my_man "my_man"
    else
      echo "Too many parameters: 1 parameter expected"
      echo
      my_man "my_man"
    fi
    return 1
  fi

  name_of_command=$1 # The name of the command to display information about

  if [ -z "$name_of_command" ]; then
    echo "Empty command name"
    return 1
  fi

  # Function to extract and display information about custom commands
  extract_custom_commands_info() {
    local type # The type of the custom command (alias, function, export, or source)
    local name # The name of the custom command
    local desc # The description of the custom command
    local usage # The usage of the custom command
    local param_info # Information about each parameter

    type=$1
    name=$(echo "$2" | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-) # The name of the custom command
    desc=$(echo "$3" | grep -oE "@description: [^\"]+" | cut -d ' ' -f 2-) # The description of the custom command
    echo "Command $name:"
    echo "- Name : $name"
    echo "- Type : $type"
    echo "- Description : $desc"

    if [[ $4 != "" ]]; then
      usage=$(echo "$4" | grep -oE "@usage: [^\"]+" | cut -d ' ' -f 2-) # The usage of the custom command
      echo "- Usage : $usage"
    fi

    # if type is export, don't continue
    if [[ $type == "EXPORT" ]]; then
      return 0
    fi

    # Loop to handle multiple parameters
    shift 4 # Ignore the first four arguments already used
    for param in "$@"; do
      if [[ $param != "" ]]; then
        param_info=$(echo "${param}" | grep -oE "@param: [^\"]+" | cut -d ' ' -f 2-) # Information about each parameter
        echo "- Param : $param_info"
      fi
    done
  }

  all_data=$(cat "${BASHRC_FILE}" "${ALIAS_FILE}" "${FUNCTIONS_FILE}" "${EXPORTS_FILE}") # Concatenate all custom command files
  type="NONE" # Initialize the type of custom command
  params=() # Array to store parameter lines

  # Loop through all lines in the concatenated custom command files
  while IFS= read -r line; do
    # Determine the type of custom command based on the line prefix
    if [[ $line == "# @alias"* ]]; then
      type="ALIAS"
    elif [[ $line == "# @export"* ]]; then
      type="EXPORT"
    elif [[ $line == "# @function"* ]]; then
      type="FUNCTION"
    elif [[ $line == "# @source"* ]]; then
      type="SOURCE"
    elif [[ $line == "# @name"* && "$type" != "NONE" ]]; then
      nameLine=$line
      name=$(echo "${line}" | grep -oE "@name: [^\"]+" | cut -d ' ' -f 2-)
    elif [ "$name" == "$name_of_command" ]; then
      # Extract and display information about the custom command
      if [[ $line == "# @description"* ]]; then
        descLine=$line
      elif [[ $line == "# @usage"* ]]; then
        usageLine=$line
      elif [[ $line == "# @param"* ]]; then
        params+=("$line") # Add parameter line to the array
      else
        if [[ ${#params[@]} -gt 0 ]]; then
          extract_custom_commands_info "$type" "$nameLine" "$descLine" "$usageLine" "${params[@]}"
          return 0
        fi
      fi
    else
      # Reset variables for the next custom command
      type="NONE"
      name=""
      nameLine=""
      descLine=""
      usageLine=""
      params=() # Reset the parameter array
    fi
  done <<< "$all_data"

  echo "Command not found"
}
