# ALIAS FILE

# @alias
# @name: cls
# @description: Clear the terminal screen
# @usage: cls
# @param: Aucun
alias cls="clear"

# @alias
# @name: lsr
# @description: List files in the root directory
# @usage: lsr
# @param: Aucun
alias lsr="ls /"

# @alias
# @name: ll
# @description: List files in the current directory with details
# @usage: ll /path/to/directory or ll
# @param: [directory]: The directory to list
alias ll="ls -alF"

# @alias
# @name: llr
# @description: List files in the root directory with details
# @usage: llr
# @param: Aucun
alias llr="ll /"

# @alias
# @name: cd_tmp
# @description: Change directory to /tmp
# @usage: cd_tmp
# @param: Aucun
alias cd_tmp="cd /tmp"

# @alias
# @name: cdu
# @description: Change directory to the parent directory
# @usage: cdu
# @param: Aucun
alias cdu="cd .."

# @alias
# @name: cdp
# @description: Change directory to the previous directory
# @usage: cdp
# @param: Aucun
alias cdp="cd -"

# @alias
# @name: h
# @description: Display the history
# @usage: h
# @param: Aucun
alias h="history"

# @alias
# @name: hf
# @description: Search the history for a command
# @usage: hf command
# @param: $*: [same as grep]
alias hf="history | grep"

# @alias
# @name: hm
# @description: Display the history with more
# @usage: hm
# @param: Aucun
alias hm="history | more"

# @alias
# @name: catB
# @description: Display the contents of the bashrc file
# @usage: catB
# @param: Aucun
# shellcheck disable=SC2139
alias catB="cat ${BASHRC_FILE}"

# @alias
# @name: catA
# @description: Display the contents of the alias file
# @usage: catA
# @param: Aucun
# shellcheck disable=SC2139
